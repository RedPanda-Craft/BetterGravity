{
  "$schema": "https://supergravity.dev/schemas/theme-v1.json",
  "id": "catppuccin-mocha",
  "name": "Catppuccin Mocha (Zero-Reflow)",
  "type": "dark",
  "version": "1.0.0",
  "author": "RedPanda-Craft",
  "tokens": {
    "--sg-surface-canvas": "#11111b",
    "--sg-surface-base": "#181825",
    "--sg-surface-raised": "#1e1e2e",
    "--sg-surface-overlay": "#313244",
    "--sg-surface-sunken": "#11111b",
    "--sg-text-primary": "#cdd6f4",
    "--sg-text-secondary": "#a6adc8",
    "--sg-text-muted": "#6c7086",
    "--sg-text-on-accent": "#11111b",
    "--sg-border-subtle": "#313244",
    "--sg-border-default": "#45475a",
    "--sg-border-strong": "#585b70",
    "--sg-border-focus": "#cba6f7",
    "--sg-accent-primary": "#cba6f7",
    "--sg-accent-hover": "#b4befe",
    "--sg-accent-subtle": "#313244",
    "--sg-selection-bg": "#45475a",
    "--sg-state-success": "#a6e3a1",
    "--sg-state-warning": "#f9e2af",
    "--sg-state-danger": "#f38ba8",
    "--sg-state-info": "#89dceb",
    "--sg-code-keyword": "#cba6f7",
    "--sg-code-string": "#a6e3a1",
    "--sg-code-function": "#89b4fa",
    "--sg-code-comment": "#6c7086",
    "--sg-radius-sm": "6px",
    "--sg-radius-md": "10px",
    "--sg-motion-fast": "120ms cubic-bezier(0.2, 0, 0, 1)"
  }
}
