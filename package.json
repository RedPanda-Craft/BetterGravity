{
  "name": "supergravity",
  "version": "1.0.0",
  "private": true,
  "description": "An open community modification platform for Google Antigravity.",
  "homepage": "https://github.com/RedPanda-Craft/SuperGravity",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bettergravity/installer dev",
    "clean": "node scripts/clean-generated.mjs",
    "build": "pnpm -r --if-present build",
    "build:installer": "pnpm build && pnpm --filter @bettergravity/installer build:desktop",
    "build:installer:win": "pnpm build && pnpm --filter @bettergravity/installer build:desktop:win",
    "build:installer:mac": "pnpm build && pnpm --filter @bettergravity/installer build:desktop:mac",
    "build:installer:linux": "pnpm build && pnpm --filter @bettergravity/installer build:desktop:linux",
    "build:installer:native:win": "node scripts/build-native-win.mjs",
    "build:installer:native:win:x64": "node scripts/build-native-win.mjs --x64",
    "build:installer:native:win:arm64": "node scripts/build-native-win.mjs --arm64",
    "build:installer:native:mac": "node scripts/build-native-mac.mjs",
    "build:installer:native:linux": "node scripts/build-native-linux.mjs",
    "start:installer": "pnpm --filter @bettergravity/installer start:desktop",
    "patch": "node scripts/dev-patch.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "community:check": "node scripts/community.mjs check",
    "community:build": "node scripts/community.mjs build",
    "verify": "pnpm verify:structure && pnpm verify:links && pnpm community:check",
    "check": "pnpm verify && pnpm typecheck && pnpm build && pnpm test",
    "agent:verify": "node scripts/agent-sentinel.mjs",
    "agent:check": "node scripts/agent-sentinel.mjs --full"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
