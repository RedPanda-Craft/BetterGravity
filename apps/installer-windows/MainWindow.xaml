<Window x:Class="BetterGravityInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SuperGravity Installer"
        Height="640" Width="720"
        MinHeight="580" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#E3E3E3"
        FontFamily="Segoe UI, Google Sans Text, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Action Card Base Style (Border-free) -->
        <Style x:Key="ActionCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1B1E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25272D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F3138"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.32"/>
                                <Setter TargetName="border" Property="Background" Value="#151618"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Card Style (Willow Blue Atmosphere, Border-free) -->
        <Style x:Key="PrimaryCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButtonStyle}">
            <Setter Property="Background" Value="#17243B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2F4D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#253A5E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.32"/>
                                <Setter TargetName="border" Property="Background" Value="#131922"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Card Style (Willow Red Tint on Hover, Border-free) -->
        <Style x:Key="DangerCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#291A1D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#351F23"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.32"/>
                                <Setter TargetName="border" Property="Background" Value="#151618"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E918F"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#25272D"/>
                                <Setter Property="Foreground" Value="#F1F3F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style -->
        <Style x:Key="WindowCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowControlBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#D93025"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Link Button Style (Border-free) -->
        <Style x:Key="PillLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1D21"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C4C7C5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#272930"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#31333C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer Pill Button Style (Border-free) -->
        <Style x:Key="FooterPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1D21"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C4C7C5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#272930"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#31333C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN SHELL BORDER (Border-free) -->
    <Border x:Name="RootBorder" Background="#111214" BorderThickness="0" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Titlebar -->
                <RowDefinition Height="*"/>
                <!-- Body -->
                <RowDefinition Height="50"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Atmospheric Ambient Glow (Willow Aurora) -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                <Ellipse Width="560" Height="280" Canvas.Left="80" Canvas.Top="-80" Opacity="0.4">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#294375" Offset="0"/>
                            <GradientStop Color="#14213B" Offset="0.5"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- 1. TITLEBAR (Border-free) -->
            <Border Grid.Row="0" Background="#111214" BorderThickness="0" MouseDown="Titlebar_MouseDown">
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/logo.png"
                               Width="26" Height="26"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"/>
                        <TextBlock Text="SuperGravity" FontWeight="SemiBold" FontSize="13.5" Foreground="#F1F3F4" VerticalAlignment="Center"/>
                        <Border Background="#1C1D21" BorderThickness="0" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="INSTALLER" FontWeight="SemiBold" FontSize="8.5" Foreground="#9AA0A6"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Cloud Sync Status Pill -->
                        <Border x:Name="SyncStatusPill" Background="#142118" BorderThickness="0" CornerRadius="6" Padding="7,2.5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SyncStatusDot" Width="6" Height="6" Fill="#81C995" Margin="0,0,5,0"/>
                                <TextBlock x:Name="SyncStatusText" Text="ONLINE" Foreground="#81C995" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1D21" BorderThickness="0" CornerRadius="6" Padding="7,2.5" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadgeText" Text="v1.0.0" Foreground="#8E918F" FontSize="10.5" FontFamily="Consolas, monospace"/>
                        </Border>
                        <Button Style="{StaticResource WindowControlBtnStyle}" Content="─" Click="Minimize_Click" FontSize="10"/>
                        <Button Style="{StaticResource WindowCloseBtnStyle}" Content="✕" Click="Close_Click" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY -->
            <Grid Grid.Row="1" Margin="28,14,28,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Host Environment Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action Cards -->
                    <RowDefinition Height="Auto"/>
                    <!-- Location Selector -->
                    <RowDefinition Height="*"/>
                    <!-- Progress Panel -->
                </Grid.RowDefinitions>

                <!-- Hidden anchor so code-behind doesn't break -->
                <TextBlock x:Name="StateEyebrowText" Visibility="Collapsed"/>

                <!-- 1. Header Area (Clean, without Action Available pill) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="StateTitleText" Text="Antigravity is ready." FontWeight="SemiBold" FontSize="26" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StateDescText" Text="A supported Antigravity installation was found. SuperGravity is not installed yet." FontSize="13" Foreground="#9AA0A6"/>
                </StackPanel>

                <!-- 2. Host Environment Card (Border-free) -->
                <Border Grid.Row="1" Background="#18191D" BorderThickness="0" CornerRadius="16" Padding="16,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Host Icon Circle (Border-free) -->
                        <Border Grid.Column="0" Width="42" Height="42" Background="#24262C" BorderThickness="0" CornerRadius="21" Margin="0,0,14,0">
                            <TextBlock Text="AG" FontWeight="Bold" FontSize="11.5" Foreground="#C4C7C5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Host Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DETECTED HOST APPLICATION" FontSize="8.5" FontWeight="SemiBold" Foreground="#80868B"/>
                            <TextBlock x:Name="HostVersionText" Text="Detecting version…" FontSize="13.5" FontWeight="SemiBold" Foreground="#F1F3F4" Margin="0,1,0,1"/>
                            <TextBlock x:Name="HostPathText" Text="Scanning standard installation locations…" FontSize="11" Foreground="#8E918F" FontFamily="Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Status Dot Indicator -->
                        <Border Grid.Column="2" x:Name="StatePillBorder" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#FDD663"/>
                                <TextBlock x:Name="StateLabelText" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Three Action Cards (Border-free with Circular Icons) -->
                <StackPanel Grid.Row="2" x:Name="ActionsGroupPanel">
                    <!-- Action 1: Install / Reapply (Primary Willow Blue) -->
                    <Button x:Name="InstallActionBtn" Style="{StaticResource PrimaryCardButtonStyle}" Height="66" Margin="0,0,0,9" Click="InstallBtn_Click">
                        <Grid Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon Circle (Border-free) -->
                            <Border Grid.Column="0" Width="42" Height="42" Background="#1E3154" BorderThickness="0" CornerRadius="21" Margin="0,0,14,0">
                                <TextBlock x:Name="InstallIconText" Text="↓" FontSize="17" FontWeight="Bold" Foreground="#8AB4F8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Center Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="InstallLabelText" Text="Install SuperGravity" FontSize="14" FontWeight="SemiBold" Foreground="#F1F3F4"/>
                                <TextBlock x:Name="InstallHintText" Text="Back up original bundle, then patch Antigravity." FontSize="11.5" Foreground="#9AA0A6" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Trailing Chip (Border-free) -->
                            <Border Grid.Column="2" Width="32" Height="32" Background="#1E3154" BorderThickness="0" CornerRadius="16">
                                <Path Data="M 2,8 L 14,8 M 8.5,2.5 L 14,8 L 8.5,13.5" Stroke="#8AB4F8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Action 2: Reinstall (Willow Neutral) -->
                    <Button x:Name="ReinstallActionBtn" Style="{StaticResource ActionCardButtonStyle}" Height="66" Margin="0,0,0,9" Click="ReinstallBtn_Click">
                        <Grid Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon Circle (Border-free) -->
                            <Border Grid.Column="0" Width="42" Height="42" Background="#24262C" BorderThickness="0" CornerRadius="21" Margin="0,0,14,0">
                                <TextBlock Text="↻" FontSize="16" FontWeight="Bold" Foreground="#C4C7C5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Center Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ReinstallLabelText" Text="Reinstall SuperGravity" FontSize="14" FontWeight="SemiBold" Foreground="#F1F3F4"/>
                                <TextBlock Text="Rebuild the patch from the original backup bundle." FontSize="11.5" Foreground="#8E918F" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Trailing Chip (Border-free) -->
                            <Border Grid.Column="2" Width="32" Height="32" Background="#24262C" BorderThickness="0" CornerRadius="16">
                                <Path Data="M 2,8 L 14,8 M 8.5,2.5 L 14,8 L 8.5,13.5" Stroke="#8E918F" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Action 3: Delete (Willow Danger Hover) -->
                    <Button x:Name="DeleteActionBtn" Style="{StaticResource DangerCardButtonStyle}" Height="66" Margin="0,0,0,0" Click="DeleteBtn_Click">
                        <Grid Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon Circle (Border-free) -->
                            <Border Grid.Column="0" Width="42" Height="42" Background="#2B1C1E" BorderThickness="0" CornerRadius="21" Margin="0,0,14,0">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#F28B82" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Center Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Delete SuperGravity" FontSize="14" FontWeight="SemiBold" Foreground="#F1F3F4"/>
                                <TextBlock Text="Restore Antigravity to stock. Themes and plugins are kept." FontSize="11.5" Foreground="#8E918F" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Trailing Chip (Border-free) -->
                            <Border Grid.Column="2" Width="32" Height="32" Background="#24262C" BorderThickness="0" CornerRadius="16">
                                <Path Data="M 2,8 L 14,8 M 8.5,2.5 L 14,8 L 8.5,13.5" Stroke="#8E918F" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Location Selector Pill (Border-free) -->
                <Button Grid.Row="3" Style="{StaticResource PillLinkButtonStyle}" HorizontalAlignment="Center" Margin="0,13,0,0" Click="ChooseLocation_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#8E918F" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Choose a different installation folder…" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 4. Progress Panel (Shown when running, Border-free) -->
                <Border Grid.Row="4" x:Name="ProgressPanel" Visibility="Collapsed" Background="#18191D" BorderThickness="0" CornerRadius="16" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="ProgressStageText" Text="PREPARING" FontSize="9.5" FontWeight="SemiBold" Foreground="#8AB4F8"/>
                            <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="11.5" Foreground="#8AB4F8" HorizontalAlignment="Right" FontFamily="Consolas, monospace"/>
                        </Grid>
                        <ProgressBar x:Name="ProgressBarCtrl" Height="5" Background="#242529" Foreground="#8AB4F8" BorderThickness="0"/>
                        <TextBlock x:Name="ProgressMsgText" Text="Starting..." FontSize="11.5" Foreground="#8E918F" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. FOOTER (Border-free, Elevated Pills) -->
            <Border Grid.Row="2" Background="#111214" BorderThickness="0">
                <Grid Margin="28,0,28,14">
                    <!-- Left: Security Guarantee Pill (Border-free) -->
                    <Border Background="#142118" BorderThickness="0" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" Fill="#81C995" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Original bundle is safely backed up before patching" Foreground="#81C995" FontSize="11.5" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Action Pills (Border-free) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource FooterPillButtonStyle}" Margin="0,0,8,0" Content="Runtime log" Click="OpenLog_Click"/>
                        <Button Style="{StaticResource FooterPillButtonStyle}" Content="Close" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
