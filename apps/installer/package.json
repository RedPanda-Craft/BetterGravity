{
  "name": "@bettergravity/installer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "The SuperGravity installer.",
  "homepage": "https://github.com/RedPanda-Craft/SuperGravity",
  "author": "BetterGravity Contributors <contributors@bettergravity.org>",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node build-electron.mjs",
    "build:desktop": "pnpm build && electron-builder",
    "build:desktop:win": "pnpm build && electron-builder --win portable",
    "build:desktop:mac": "pnpm build && electron-builder --mac",
    "build:desktop:linux": "pnpm build && electron-builder --linux",
    "start:desktop": "electron dist-electron/main.cjs",
    "dev:desktop": "cross-env BG_DEV_SERVER_URL=http://127.0.0.1:4173 electron dist-electron/main.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bettergravity/patcher": "workspace:*",
    "@bettergravity/runtime": "workspace:*",
    "@bettergravity/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "desktopName": "bettergravity-installer.desktop",
  "build": {
    "appId": "com.bettergravity.installer",
    "productName": "BetterGravity Installer",
    "executableName": "bettergravity-installer",
    "artifactName": "BetterGravity-Installer-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "dist-electron/runtime/**"
    ],
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "BetterGravity-Installer-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "artifactName": "BetterGravity-Installer-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "artifactName": "BetterGravity-Installer-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "dmg": {
      "title": "BetterGravity Installer ${version}"
    }
  }
}
